{
  "$schema": "https://opencode.ai/config.json",
  "model": "ollama/qwen3.5:9b",
  "small_model": "ollama/qwen3.5:9b",
  "provider": {
    "ollama": {
      "name": "Ollama (local)",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://127.0.0.1:11435/v1"
      },
      "models": {
        "qwen3.5:9b": {
          "name": "Qwen3.5 9B",
          "reasoning": false,
          "tool_call": true,
          "limit": {
            "context": 32768,
            "output": 4096
          }
        },
        "qwen3.5:4b": {
          "name": "Qwen3.5 4B",
          "reasoning": false,
          "tool_call": true,
          "limit": {
            "context": 32768,
            "output": 4096
          }
        }
      }
    }
  },
  "plugin": [
    "openviking-opencode",
    "openrtk",
    "@tarquinen/opencode-dcp@latest",
    "./plugins/auto-recall.ts",
    "./plugins/auto-explore.ts"
  ],
  "permission": "allow",
  "mcp": {
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@latest",
        "--isolated"
      ],
      "enabled": true
    },
    "postman": {
      "type": "remote",
      "url": "https://mcp.postman.com/mcp",
      "enabled": false
    }
  }
}
