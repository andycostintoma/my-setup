{
  "plugin": [
    "./plugins/automation/sound-notify.ts"
  ],
  "provider": {
    "ollama-heretic": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama Heretic (my-setup)",
      "options": {
        "baseURL": "http://127.0.0.1:11435/v1",
        "apiKey": "ollama"
      },
      "models": {
        "qwen2.5-coder-7b-heretic": {
          "name": "Qwen2.5 Coder 7B Heretic",
          "family": "qwen2.5-coder",
          "tool_call": true,
          "temperature": true,
          "limit": {
            "context": 32768,
            "output": 4096
          }
        }
      }
    }
  },
  "agent": {
    "local-heretic": {
      "description": "Uses the my-setup local Heretic Qwen2.5 Coder model for lightweight browser, search, and tool-loop tasks.",
      "mode": "primary",
      "model": "ollama-heretic/qwen2.5-coder-7b-heretic"
    }
  }
}
