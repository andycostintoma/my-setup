{
  "$schema": "https://opencode.ai/config.json",
  "snapshot": false,
  "provider": {},
  "plugin": [
    "openrtk",
    "@tarquinen/opencode-dcp@latest",
    "opencode-claude-auth@latest",
    "./plugins/sound-notify.ts"
  ],
  "permission": "allow",
  "tool_output": {
    "max_lines": 400,
    "max_bytes": 20000
  },
  "mcp": {
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@latest",
        "--isolated"
      ],
      "enabled": false
    }
  }
}
